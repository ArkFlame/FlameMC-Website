---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
interface Props { guide: CollectionEntry<'guides'>; related: CollectionEntry<'guides'>[]; }
export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide, related: guides.filter(other => other.id !== guide.id).sort((a,b) => (a.data.category === guide.data.category ? -1 : 1)).slice(0,3) },
  }));
}
const { guide, related } = Astro.props;
const { Content } = await render(guide);
const base = 'https://flamemc.arkflame.com';
const canonical = `${base}/guides/${guide.id}/`;
const published = guide.data.publishedAt.toISOString();
const modified = (guide.data.updatedAt ?? guide.data.publishedAt).toISOString();
const schema = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: guide.data.title, description: guide.data.description,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical, image: `${base}/og-image.png`,
  datePublished: published, dateModified: modified,
  author: { '@type': 'Organization', name: 'FlameMC', url: `${base}/` },
  publisher: { '@type': 'Organization', name: 'FlameMC', url: `${base}/` },
  inLanguage: 'en', isAccessibleForFree: true,
};
---
<BaseLayout title={`${guide.data.title} | FlameMC`} description={guide.data.description} path={`/guides/${guide.id}/`} type="article" publishedTime={published} modifiedTime={modified} schema={schema}>
  <main id="content" class="editorial-page article-page">
    <article class="container article-shell">
      <nav class="article-breadcrumb" aria-label="Breadcrumb"><a href="/">FlameMC</a><span aria-hidden="true">/</span><a href="/guides/">Guides</a><span aria-hidden="true">/</span><span>{guide.data.category}</span></nav>
      <header class="article-header">
        <div class="editorial-overline"><span class="status-led"></span> {guide.data.category.toUpperCase()} <span class="editorial-divider">/</span> FLAMEMC FIELD NOTES</div>
        <h1>{guide.data.title}</h1>
        <p class="article-deck">{guide.data.description}</p>
        <div class="article-byline"><span>FLAMEMC</span><span aria-hidden="true">·</span><time datetime={published}>{guide.data.publishedAt.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time><span aria-hidden="true">·</span><span>{guide.data.readingMinutes} MIN READ</span></div>
      </header>
      <div class="article-layout">
        <aside class="article-aside"><span class="aside-label">THE SHORT ANSWER</span><p>{guide.data.takeaway}</p><div class="aside-rule"></div><a href="/guides/">ALL GUIDES <span aria-hidden="true">↗</span></a></aside>
        <div class="article-content prose"><Content /></div>
      </div>
    </article>
    <section class="container related-section"><div class="related-heading"><span class="kicker">KEEP READING</span><h2>Related guides.</h2></div><div class="related-grid">{related.map(item => <a class="related-card" href={`/guides/${item.id}/`}><span>{item.data.category.toUpperCase()}</span><h3>{item.data.title}</h3><span class="related-arrow" aria-hidden="true">↗</span></a>)}</div></section>
    <section class="container article-bottom-cta"><div><span class="kicker">NOW AVAILABLE</span><h2>Scale your world.<br/><span>Keep your plugins.</span></h2><p>Explore FlameMC on BuiltByBit and check the current compatibility and release details.</p></div><a class="button button-primary" href="https://builtbybit.com/resources/flamemc-extreme-async-performance.133143/" target="_blank" rel="noopener noreferrer">Get FlameMC <span aria-hidden="true">↗</span></a></section>
  </main>
</BaseLayout>
