---
interface Props {
  title: string;
  description: string;
  path?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  schema?: Record<string, unknown>;
}
const {
  title,
  description,
  path = Astro.url.pathname,
  type = 'website',
  image = '/og-image.png',
  publishedTime,
  modifiedTime,
  schema,
} = Astro.props;
const base = 'https://flamemc.arkflame.com';
const canonical = new URL(path, base).toString();
const imageUrl = new URL(image, base).toString();
const rootSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': `${base}/#publisher`,
      name: 'FlameMC', url: `${base}/`,
      parentOrganization: { '@type': 'Organization', name: 'ArkFlame Studios', url: 'https://arkflame.com/' },
      sameAs: ['https://builtbybit.com/resources/flamemc-extreme-async-performance.133143/'],
    },
    { '@type': 'WebSite', '@id': `${base}/#website`, name: 'FlameMC', url: `${base}/`,
      publisher: { '@id': `${base}/#publisher` }, inLanguage: 'en' },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#09090d" />
  <meta name="color-scheme" content="dark" />
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title="FlameMC Guides" href="/rss.xml" />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="FlameMC" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:alt" content="FlameMC — Minecraft server software with Folia threading and Paper compatibility" />
  <meta property="og:url" content={canonical} />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/styles/site.css" />
  <link rel="stylesheet" href="/styles/content.css" />
  <script type="application/ld+json" set:html={JSON.stringify(schema ?? rootSchema).replace(/</g,'\\u003c')}></script>
  <script is:inline src="/scripts/site.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <div class="page-noise" aria-hidden="true"></div>
  <header class="site-header" data-header>
    <div class="header-inner container">
      <a class="brand" href="/" aria-label="FlameMC home">
        <svg class="brand-flame" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path d="M38 4C37 16 27 23 29 32c-6-4-8-9-7-16C12 25 9 34 13 45c3 10 11 16 21 16 12 0 22-11 19-23-2-9-7-15-13-20 1 7 0 12-4 16-4-9 0-21 2-30Z" fill="currentColor"/><path d="M32 36c-1 8-8 10-6 17 1 4 5 6 9 6 6 0 10-5 9-11-1-4-4-7-7-10-1 5-3 8-5 9 0-4 1-7 0-11Z" fill="#0b090b"/></svg>
        <span>Flame<span class="brand-accent">MC</span></span>
      </a>
      <nav class="nav-links" id="primary-nav" aria-label="Main navigation" data-menu>
        <a href="/#advantages">Benefits</a>
        <a href="/#architecture">Architecture</a>
        <a href="/#comparison">Threading</a>
        <a href="/guides/">Guides</a>
        <a class="nav-action" href="https://builtbybit.com/resources/flamemc-extreme-async-performance.133143/" target="_blank" rel="noopener noreferrer">Get FlameMC <span aria-hidden="true">↗</span></a>
      </nav>
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-controls="primary-nav" aria-expanded="false" data-menu-toggle><span></span><span></span></button>
    </div>
  </header>
  <slot />
  <footer class="site-footer"><div class="container footer-inner">
    <a class="footer-brand" href="/">FLAME<span>MC</span></a>
    <span>THE CONCURRENCY OF FOLIA. THE ECOSYSTEM OF PAPER.</span>
    <div class="footer-link-group"><a href="/guides/">GUIDES</a><a href="/download/">DOWNLOAD</a><a href="https://arkflame.com/" target="_blank" rel="noopener noreferrer">ARKFLAME STUDIOS ↗</a><span>© 2026 FLAMEMC</span></div>
  </div></footer>
</body>
</html>
